# 填企业微信群机器人的完整 Webhook 地址，或在 config-prod.yaml 中设置。
WECHAT_ENABLED=
WECHAT_WEBHOOK_URL=

# Telegram 开关为空时沿用 YAML；Token 和数字 Chat ID 只填私有文件。
TELEGRAM_ENABLED=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PROXY=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=teslamate
DB_USER=teslamate
DB_PASSWORD=your-database-password

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Shanghai
